# Copy to a file OUTSIDE the repo (or set the variables in your process manager). Never commit real values.
# 48 random bytes: openssl rand -base64 48
CONCLAVE_AUTH_SECRET=
# the RPC / indexer URL, including the provider API key when it uses one (this stays on the server)
CONCLAVE_RPC_UPSTREAM=https://rpc.magicblock.app/devnet
# the rollup endpoint, used only for the public claims view (owed versus claimed). Leave empty to disable that route
CONCLAVE_ROLLUP_UPSTREAM=https://devnet-tee.magicblock.app
CONCLAVE_AUDIENCE=conclave-api
CONCLAVE_PROGRAM_ID=HZ3b6zexePfH5cXT5qaKKHfA8B29xwBGGYgu84WgMdne
# browser origins allowed by CORS, comma separated
CONCLAVE_ALLOWED_ORIGINS=
PORT=8787
# or point at files instead: CONCLAVE_AUTH_SECRET_FILE, CONCLAVE_RPC_UPSTREAM_FILE
# the record API (docs/API.md): the store the capture loop writes (node verifier/cli.mjs ingest --store DIR). Without it /v1 answers 404 store_not_configured
CONCLAVE_STORE_DIR=
# the counting rules in force, as a JSON file (see verifier/policy/rules.example.json). Without it the leaderboard counts nothing and says so
CONCLAVE_RULES_FILE=
# ---- record-only mode (the Railway deployment, docs/DEPLOY_RAILWAY.md): the record API alone, no secret and no upstream needed
# CONCLAVE_RECORD_ONLY=1
# how callers are told apart for rate limiting: socket (default) | global (one bucket, limits raised) | x-real-ip | xff-first (only behind a proxy that overwrites the header)
# CONCLAVE_CLIENT_IP=socket
# budget for the routes that scan the program upstream per request (full server only): cache seconds, per player per minute, for everybody per minute
# CONCLAVE_GPA_CACHE_SECONDS=60
# RATE_GPA_PLAYER_PER_MIN=4
# RATE_GPA_GLOBAL_PER_MIN=6
