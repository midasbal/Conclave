# The record API the /app pages read, from the server only. The service's base address, without /v1.
# Leave it empty and /app says that no record is connected.
CONCLAVE_API_URL=

# The operator service that pays a visitor's devnet cost (../operator), called by /api/drip from the server only. Its base address, and the same
# shared secret the service has. Without the address, /api/drip answers that funding is not set up.
OPERATOR_API_URL=
OPERATOR_SHARED_SECRET=
